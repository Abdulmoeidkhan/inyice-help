{
  "name": "inyice-help",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3001",
    "build": "next build",
    "start": "node scripts/start-production.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "export:help-links": "node scripts/export-help-links.mjs",
    "prebuild": "npm test && npm run export:help-links",
    "postbuild": "node scripts/prepare-standalone.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.11.0",
    "next": "16.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
